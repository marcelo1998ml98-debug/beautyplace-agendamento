# Copie este arquivo para ".env" e ajuste os valores antes de rodar em producao

PORT=3000

# String de conexao do banco Postgres (ex: a do Supabase, em Project Settings >
# Database > Connection string > "Connection pooling"). Sem isso o servidor
# nao sobe. Formato: postgresql://usuario:senha@host:porta/postgres
DATABASE_URL=

# Senha de acesso ao painel administrativo (/admin). Obrigatoria, sem valor
# padrao - o servidor recusa iniciar se isso estiver vazio.
ADMIN_PASSWORD=

# Segredo usado para assinar o cookie de sessao do admin. Obrigatoria, sem
# valor padrao. Gere um valor aleatorio.
SESSION_SECRET=

# Defina como "true" pra conectar de verdade no WhatsApp do Beauty Place
# (Baileys). Deixe "false" pra testar o fluxo sem enviar mensagens de verdade.
WHATSAPP_ENABLED=false

# E-mail de confirmacao pro cliente, enviado via Brevo. Sem essas duas
# variaveis definidas, roda em modo simulado (so imprime no console).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
EMAIL_SENDER_NAME=Beauty Place

# Opcional. E-mail que recebe o aviso de "nova marcacao" assim que um cliente
# agenda pelo site.
BUSINESS_NOTIFICATION_EMAIL=

# Opcional. Endereco fisico exibido no rodape dos e-mails.
BUSINESS_ADDRESS=

# Token secreto que protege o endpoint de lembrete automatico
# (/api/cron/send-reminders?token=...).
CRON_SECRET=

# Opcional. Defina como "true" pra validar de verdade o certificado TLS da
# conexao com o Postgres.
DATABASE_SSL_REJECT_UNAUTHORIZED=
